<meta>
  <meta-item key="Autor">Theo</meta-item>
  <meta-item key="Referência"><link to="https://pages.stat.wisc.edu/~shao/stat610/Casella_Berger_Statistical_Inference.pdf">Casella e Berger, Statistical Inference, 2ª edição, capítulo 1</link></meta-item>
